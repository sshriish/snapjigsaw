+  "indexes": [
+    {
+      "collectionGroup": "polaroids",
+      "queryScope": "COLLECTION",
+      "fields": [
+        { "fieldPath": "userId", "order": "ASCENDING" },
+        { "fieldPath": "createdAt", "order": "DESCENDING" }
+      ]
+    }
+  ],
+  "fieldOverrides": []
+}
diff --git a/firebase/firestore.rules b/firebase/firestore.rules
new file mode 100644
index 0000000..e5cc3fb
--- /dev/null
+++ b/firebase/firestore.rules
@@ -0,0 +1,16 @@
+rules_version = '2';
+
+service cloud.firestore {
+  match /databases/{database}/documents {
+    match /polaroids/{polaroidId} {
+      // Owners can fully manage their own polaroids.
+      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
+      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
+
+      // Anyone (including signed-out visitors) can read a polaroid IF it has
+      // been explicitly shared — this is what powers public share links
+      // without exposing the rest of a user's wall.
+      allow read: if resource.data.shareSlug != null;
+    }
+  }
+}
diff --git a/firebase/storage.rules b/firebase/storage.rules
new file mode 100644
index 0000000..b1b4d3a
--- /dev/null
+++ b/firebase/storage.rules
@@ -0,0 +1,11 @@
+rules_version = '2';
+
+service firebase.storage {
+  match /b/{bucket}/o {
+    // Path convention: polaroids/{userId}/{polaroidId}.jpg
+    match /polaroids/{userId}/{fileName} {
+      allow read: if true; // images are only meaningful when linked from a shared/owned doc
+      allow write: if request.auth != null && request.auth.uid == userId;
+    }
+  }
+}
